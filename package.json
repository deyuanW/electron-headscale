{
  "name": "headscale-desktop",
  "version": "1.0.0",
  "description": "跨平台 Headscale 桌面管理客户端（Electron + Vue 3）",
  "main": "./out/main/index.js",
  "author": "Headscale Desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "fetch:tailscale": "node scripts/fetch-tailscale.mjs",
    "build:unpack": "npm run build && npm run fetch:tailscale && electron-builder --dir",
    "build:win": "npm run build && npm run fetch:tailscale && electron-builder --win",
    "build:mac": "npm run build && npm run fetch:tailscale && electron-builder --mac",
    "build:linux": "npm run build && npm run fetch:tailscale && electron-builder --linux"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.headscale.desktop",
    "productName": "Headscale Desktop",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/tailscale/win32-x64",
          "to": "tailscale/win32-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Headscale Desktop"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/tailscale/darwin-x64",
          "to": "tailscale/darwin-x64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/tailscale/darwin-arm64",
          "to": "tailscale/darwin-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/tailscale/linux-x64",
          "to": "tailscale/linux-x64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/tailscale/linux-arm64",
          "to": "tailscale/linux-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  }
}
